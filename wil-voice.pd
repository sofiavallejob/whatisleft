#X obj 20 200 expr 0.034*pow(\$f1/49 \,-0.4)*\$f2 \; 0.034*pow(\$f1/49 \,-0.4)*(0.22*\$f5+0.3*\$f6) \; \$f7+\$f4*\$f9-100*\$f6 \; \$f8*(1-\$f4-\$f6)+\$f10*\$f4+0.95*\$f6 \; \$f3*55 \; \$f3*0.017*pow(\$f1/49 \,-0.4);
#X obj 20 150 f;
#X obj 600 30 loadbang;
#X obj 600 60 expr (random(0 \,10000)/10000.0-0.5)*22 \; (random(0 \,10000)/10000.0-0.5)*0.7 \; if(random(0 \,2)==0 \,-1 \,1)*(40+random(0 \,10000)/10000.0*70) \; if(random(0 \,2)==0 \,-0.95 \,0.95) \; 0.08+random(0 \,10000)/10000.0*0.35 \; 0.4+random(0 \,10000)/10000.0*1.6;
